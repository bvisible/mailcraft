msgstr "El remitente usa su nombre, pero el mensaje llegó desde {real}, que no es una de sus direcciones."

msgid "The sender's address is at {domain}."
msgstr "La dirección del remitente está en {domain}."

msgid "The sender's domain, {domain}, looks like {like}, which you correspond with, but it isn't the same."
msgstr "El dominio del remitente, {domain}, se parece a {like}, con el que se corresponde, pero no es el mismo."

