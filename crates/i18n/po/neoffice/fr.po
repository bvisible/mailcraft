# //// Neoffice — added file (no upstream equivalent): the French of this fork's own texts, and of the few choices it makes over
# upstream's catalogue (a numeric date with dots, as in Switzerland). Read over `po/fr.po` (an entry here wins), so that
# upstream's catalogue stays upstream's and is regenerated by `cargo xtask i18n` at each merge. Translations by Haiku.
msgid ""
msgstr ""
"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

