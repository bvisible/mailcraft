msgstr "Nora konnte keine Antworten vorbereiten: {reason}"

msgid "My Style"
msgstr "Mein Stil"

msgid "{n} field to fill in"
msgid_plural "{n} fields to fill in"
msgstr[0] "{n} Feld auszufüllen"
msgstr[1] "{n} Felder auszufüllen"

msgid "Sending in {n} second…"
msgid_plural "Sending in {n} seconds…"
msgstr[0] "Senden in {n} Sekunde…"
msgstr[1] "Senden in {n} Sekunden…"

msgid "Learnt on {date} from {n} sent email."
msgid_plural "Learnt on {date} from {n} sent emails."
msgstr[0] "Gelernt am {date} aus {n} gesendeter E-Mail."
msgstr[1] "Gelernt am {date} aus {n} gesendeten E-Mails."

msgid "{n} excerpt of your replies, kept as an example"
msgid_plural "{n} excerpts of your replies, kept as examples"
msgstr[0] "{n} Auszug aus Ihren Antworten, als Beispiel behalten"
msgstr[1] "{n} Auszüge aus Ihren Antworten, als Beispiele behalten"

msgid "Change this mailbox's servers, password and name on the site"
